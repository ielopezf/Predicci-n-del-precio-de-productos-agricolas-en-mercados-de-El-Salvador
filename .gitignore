# --- Datos (no versionar archivos pesados; sí las plantillas .gitkeep) ---
data/raw/*
data/interim/*
data/processed/*
data/external/*
!data/**/.gitkeep

# Dataset necesario para la aplicación desplegada
!data/processed/dataset_modelado.csv


# --- Modelos serializados ---

models/*
!models/.gitkeep

# Modelos necesarios para la aplicación desplegada
!models/*.pkl
!models/*.keras

# --- Figuras generadas ---
reports/figures/*
!reports/figures/.gitkeep

# --- Python ---
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/
env/
*.egg-info/

# --- Entorno / editores ---
.vscode/
.idea/
.DS_Store
.env

# --- Pruebas, MLflow y secretos de Streamlit ---
.pytest_cache/
mlruns/
.streamlit/secrets.toml

# --- Salidas de prueba y carpetas de herramientas locales ---
reports/etapa3/*_stub.csv
.agents/
.claude/